{
    "name":  "beholder-eyes",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Beholder Eye\u0027s — универсальный трекер для мастера D\u0026D 5e",
    "main":  "dist/main/index.js",
    "author":  "azis",
    "scripts":  {
                    "dev":  "electron-vite dev",
                    "build":  "electron-vite build",
                    "build:player-form":  "vite build -c vite.player.config.ts",
                    "preview":  "electron-vite preview",
                    "preview:player-form":  "vite preview -c vite.player.config.ts",
                    "lint":  "eslint . --ext .ts,.tsx --max-warnings 0",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "import:assets":  "node scripts/import-assets.cjs",
                    "extract:weapons":  "node scripts/extract-weapons-json.cjs",
                    "prepare:ttg":  "node scripts/prepare-ttg-output.cjs",
                    "rebuild:electron":  "electron-rebuild -f -w better-sqlite3",
                    "postinstall":  "npm run rebuild:electron"
                },
    "dependencies":  {
                         "@emotion/react":  "^11.14.0",
                         "@mantine/core":  "^8.3.14",
                         "@mantine/hooks":  "^8.3.14",
                         "@mantine/notifications":  "^8.3.14",
                         "@tanstack/react-query":  "^5.90.20",
                         "better-sqlite3":  "^12.6.2",
                         "iconv-lite":  "^0.7.2",
                         "react":  "^18.2.0",
                         "react-dom":  "^18.2.0",
                         "zod":  "^4.3.6",
                         "zustand":  "^5.0.11"
                     },
    "devDependencies":  {
                            "@types/better-sqlite3":  "^7.6.13",
                            "@types/react":  "^18.2.0",
                            "@types/react-dom":  "^18.2.0",
                            "@vitejs/plugin-react":  "^4.2.1",
                            "electron":  "^28.2.7",
                            "electron-rebuild":  "^3.2.9",
                            "electron-vite":  "^2.1.0",
                            "eslint":  "^8.57.0",
                            "typescript":  "^5.4.0",
                            "vite":  "^5.2.0"
                        }
}
